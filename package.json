{
  "//": [
    "React is pinned to ensure Storybook uses the same versions, also we need Canary for ViewTransition.",
    "eslint-plugin-react-hooks is pinned because the latest version introduces tedious errors, will wait for React Compiler rewrite in Rust. https://github.com/facebook/react/pull/36173",
    "The debug package is pinned to prevent a million different versions getting installed."
  ],
  "name": "crosswing-monorepo",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "author": "nfarina@gmail.com",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "packages/cli/bin/crosswing.js",
    "test": "npm run fmt && npm run tsc && npm run lint && npm run vitest",
    "vitest": "vitest --run",
    "lint": "oxlint",
    "check-imports": "npx npm-check",
    "fmt": "oxfmt --check 'packages/**/*.ts' 'packages/**/*.tsx'",
    "fmt:fix": "oxfmt 'packages/**/*.ts' 'packages/**/*.tsx'",
    "circular": "npx madge --extensions ts,tsx --exclude 'lib' --circular packages",
    "tsc": "tsgo --build",
    "storybook": "storybook dev --ci -p 2702",
    "build:storybook": "storybook build",
    "clean:node_modules": "rm -rf node_modules packages/*/node_modules",
    "clean:yarn": "rm yarn.lock",
    "clean:tsc": "find . -type f -name 'tsconfig.tsbuildinfo' ! -path '*/node_modules/*' -exec rm {} +",
    "clean": "npm run clean:node_modules && npm run clean:yarn && npm run clean:tsc"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/debug": "^4.1.13",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@types/react-transition-group": "^4.4.12",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "styled-components": "^6.4.3",
    "timemachine": "^0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-node": "6.0.0",
    "vite-plugin-react-click-to-component": "^4.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vite": "^8.1.4"
  },
  "resolutions": {
    "debug": "4.4.3",
    "eslint-plugin-react-hooks": "7.1.0-canary-2ba30655-20260219",
    "react": "19.3.0-canary-d5736f09-20260507",
    "react-dom": "19.3.0-canary-d5736f09-20260507",
    "react-is": "19.3.0-canary-d5736f09-20260507"
  },
  "packageManager": "yarn@4.17.1"
}
